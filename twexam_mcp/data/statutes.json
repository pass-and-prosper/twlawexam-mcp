{
  "中華民國刑法§13": {
    "law": "中華民國刑法",
    "pcode": "C0000001",
    "no": "13",
    "content": "行為人對於構成犯罪之事實，明知並有意使其發生者，為故意。行為人對於構成犯罪之事實，預見其發生而其發生並不違背其本意者，以故意論。",
    "status": "現行法規",
    "source_url": "https://law.moj.gov.tw/LawClass/LawSingle.aspx?pcode=C0000001&flno=13",
    "fetched": "2026-06-16"
  },
  "中華民國刑法§14": {
    "law": "中華民國刑法",
    "pcode": "C0000001",
    "no": "14",
    "content": "行為人雖非故意，但按其情節應注意，並能注意，而不注意者，為過失。行為人對於構成犯罪之事實，雖預見其能發生而確信其不發生者，以過失論。",
    "status": "現行法規",
    "source_url": "https://law.moj.gov.tw/LawClass/LawSingle.aspx?pcode=C0000001&flno=14",
    "fetched": "2026-06-16"
  },
  "中華民國刑法§15": {
    "law": "中華民國刑法",
    "pcode": "C0000001",
    "no": "15",
    "content": "對於犯罪結果之發生，法律上有防止之義務，能防止而不防止者，與因積極行為發生結果者同。因自己行為致有發生犯罪結果之危險者，負防止其發生之義務。",
    "status": "現行法規",
    "source_url": "https://law.moj.gov.tw/LawClass/LawSingle.aspx?pcode=C0000001&flno=15",
    "fetched": "2026-06-16"
  },
  "中華民國刑法§16": {
    "law": "中華民國刑法",
    "pcode": "C0000001",
    "no": "16",
    "content": "除有正當理由而無法避免者外，不得因不知法律而免除刑事責任。但按其情節，得減輕其刑。",
    "status": "現行法規",
    "source_url": "https://law.moj.gov.tw/LawClass/LawSingle.aspx?pcode=C0000001&flno=16",
    "fetched": "2026-06-16"
  },
  "中華民國刑法§169": {
    "law": "中華民國刑法",
    "pcode": "C0000001",
    "no": "169",
    "content": "意圖他人受刑事或懲戒處分，向該管公務員誣告者，處七年以下有期徒刑。意圖他人受刑事或懲戒處分，而偽造、變造證據，或使用偽造、變造之證據者，亦同。",
    "status": "現行法規",
    "source_url": "https://law.moj.gov.tw/LawClass/LawSingle.aspx?pcode=C0000001&flno=169",
    "fetched": "2026-06-16"
  },
  "中華民國刑法§173": {
    "law": "中華民國刑法",
    "pcode": "C0000001",
    "no": "173",
    "content": "放火燒燬現供人使用之住宅或現有人所在之建築物、礦坑、火車、電車或其他供水、陸、空公眾運輸之舟、車、航空機者，處無期徒刑或七年以上有期徒刑。失火燒燬前項之物者，處一年以下有期徒刑、拘役或一萬五千元以下罰金。第一項之未遂犯罰之。預備犯第一項之罪者，處一年以下有期徒刑、拘役或九千元以下罰金。",
    "status": "現行法規",
    "source_url": "https://law.moj.gov.tw/LawClass/LawSingle.aspx?pcode=C0000001&flno=173",
    "fetched": "2026-06-16"
  },
  "中華民國刑法§175": {
    "law": "中華民國刑法",
    "pcode": "C0000001",
    "no": "175",
    "content": "放火燒燬前二條以外之他人所有物，致生公共危險者，處一年以上七年以下有期徒刑。放火燒燬前二條以外之自己所有物，致生公共危險者，處三年以下有期徒刑。失火燒燬前二條以外之物，致生公共危險者，處拘役或九千元以下罰金。",
    "status": "現行法規",
    "source_url": "https://law.moj.gov.tw/LawClass/LawSingle.aspx?pcode=C0000001&flno=175",
    "fetched": "2026-06-16"
  },
  "中華民國刑法§23": {
    "law": "中華民國刑法",
    "pcode": "C0000001",
    "no": "23",
    "content": "對於現在不法之侵害，而出於防衛自己或他人權利之行為，不罰。但防衛行為過當者，得減輕或免除其刑。",
    "status": "現行法規",
    "source_url": "https://law.moj.gov.tw/LawClass/LawSingle.aspx?pcode=C0000001&flno=23",
    "fetched": "2026-06-16"
  },
  "中華民國刑法§271": {
    "law": "中華民國刑法",
    "pcode": "C0000001",
    "no": "271",
    "content": "殺人者，處死刑、無期徒刑或十年以上有期徒刑。前項之未遂犯罰之。預備犯第一項之罪者，處二年以下有期徒刑。",
    "status": "現行法規",
    "source_url": "https://law.moj.gov.tw/LawClass/LawSingle.aspx?pcode=C0000001&flno=271",
    "fetched": "2026-06-16"
  },
  "中華民國刑法§276": {
    "law": "中華民國刑法",
    "pcode": "C0000001",
    "no": "276",
    "content": "因過失致人於死者，處五年以下有期徒刑、拘役或五十萬元以下罰金。",
    "status": "現行法規",
    "source_url": "https://law.moj.gov.tw/LawClass/LawSingle.aspx?pcode=C0000001&flno=276",
    "fetched": "2026-06-16"
  },
  "中華民國刑法§277": {
    "law": "中華民國刑法",
    "pcode": "C0000001",
    "no": "277",
    "content": "傷害人之身體或健康者，處五年以下有期徒刑、拘役或五十萬元以下罰金。犯前項之罪，因而致人於死者，處無期徒刑或七年以上有期徒刑；致重傷者，處三年以上十年以下有期徒刑。",
    "status": "現行法規",
    "source_url": "https://law.moj.gov.tw/LawClass/LawSingle.aspx?pcode=C0000001&flno=277",
    "fetched": "2026-06-16"
  },
  "中華民國刑法§278": {
    "law": "中華民國刑法",
    "pcode": "C0000001",
    "no": "278",
    "content": "使人受重傷者，處五年以上十二年以下有期徒刑。犯前項之罪因而致人於死者，處無期徒刑或十年以上有期徒刑。第一項之未遂犯罰之。",
    "status": "現行法規",
    "source_url": "https://law.moj.gov.tw/LawClass/LawSingle.aspx?pcode=C0000001&flno=278",
    "fetched": "2026-06-16"
  },
  "中華民國刑法§284": {
    "law": "中華民國刑法",
    "pcode": "C0000001",
    "no": "284",
    "content": "因過失傷害人者，處一年以下有期徒刑、拘役或十萬元以下罰金；致重傷者，處三年以下有期徒刑、拘役或三十萬元以下罰金。",
    "status": "現行法規",
    "source_url": "https://law.moj.gov.tw/LawClass/LawSingle.aspx?pcode=C0000001&flno=284",
    "fetched": "2026-06-16"
  },
  "中華民國刑法§29": {
    "law": "中華民國刑法",
    "pcode": "C0000001",
    "no": "29",
    "content": "教唆他人使之實行犯罪行為者，為教唆犯。教唆犯之處罰，依其所教唆之罪處罰之。",
    "status": "現行法規",
    "source_url": "https://law.moj.gov.tw/LawClass/LawSingle.aspx?pcode=C0000001&flno=29",
    "fetched": "2026-06-16"
  },
  "中華民國刑法§55": {
    "law": "中華民國刑法",
    "pcode": "C0000001",
    "no": "55",
    "content": "一行為而觸犯數罪名者，從一重處斷。但不得科以較輕罪名所定最輕本刑以下之刑。",
    "status": "現行法規",
    "source_url": "https://law.moj.gov.tw/LawClass/LawSingle.aspx?pcode=C0000001&flno=55",
    "fetched": "2026-06-16"
  }
}
